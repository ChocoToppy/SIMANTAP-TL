rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function mhsDoc(mahasiswaId) {
      return firestore.get(/databases/(default)/documents/mahasiswa/$(mahasiswaId)).data;
    }
    function akunDoc(nim) {
      return firestore.get(/databases/(default)/documents/akun/$(nim)).data;
    }
    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isAssignedLecturer(mahasiswaId) {
      let m = mhsDoc(mahasiswaId);
      let kode = request.auth.token.kode;
      return isSignedIn() && role() == 'lecturer'
        && (m.pembimbing1 == kode || m.pembimbing2 == kode || m.penguji1 == kode || m.penguji2 == kode);
    }
    function isOwnerStudent(mahasiswaId) {
      return isSignedIn() && role() == 'student'
        && akunDoc(mhsDoc(mahasiswaId).owner).uid == request.auth.uid;
    }

    // Berkas yang hanya diunggah admin: sama dengan dokumenAdmin() di
    // firestore.rules, ditambah surat perpanjangan dari admin.
    function berkasAdmin() {
      return ['stPembimbing', 'baSeminar', 'penilaianKP', 'stPembimbingMagang', 'monevMagang', 'baExpo',
              'stPembimbingMkt', 'monevMkt', 'baExpoMkt', 'baSemproTA', 'baSemhasTA', 'baSidangTA',
              'perpanjangan-admin'];
    }
    function pernahVerif(m) {
      return m.get('verifikasi', 'baru') == 'terverifikasi' || m.get('pernahTerverifikasi', false) == true;
    }
    // Sama dengan pemeriksaan readFileForUpload di utils/fileUpload.js.
    function pdfSah(fileName) {
      return request.resource.size <= 25000000
        && (request.resource.contentType == 'application/pdf' || fileName.matches('.*[.][pP][dD][fF]$'));
    }

    // Berkas mahasiswa (proposal, laporan, dokumen KP, dst.) disimpan per
    // mahasiswaId (= id dokumen mahasiswa/{id}) di uploads/{id}/{key}/{berkas}.
    // Baca: admin, dosen yang membimbing/menguji, dan mahasiswa pemiliknya.
    // Tulis: seperti di aplikasi — admin bebas; mahasiswa hanya berkasnya sendiri
    // (bukan berkas admin), PDF ≤ 25 MB, setelah pengajuan diverifikasi dan
    // selama tidak berstatus "Perlu perbaikan"; dosen
    // tidak mengunggah apa pun.
    match /uploads/{mahasiswaId}/{allPaths=**} {
      allow read: if isAdmin() || isAssignedLecturer(mahasiswaId) || isOwnerStudent(mahasiswaId);
      allow write: if isAdmin();
    }
    match /uploads/{mahasiswaId}/{key}/{fileName} {
      allow create, update: if isOwnerStudent(mahasiswaId) && !(key in berkasAdmin())
        && pdfSah(fileName) && pernahVerif(mhsDoc(mahasiswaId))
        && mhsDoc(mahasiswaId).get('verifikasi', 'baru') != 'perbaikan'; // "Perlu perbaikan" = unggah dikunci
      // Hapus: berkas yang diganti/dihapus, dan seluruh folder saat pengajuan dihapus.
      allow delete: if isOwnerStudent(mahasiswaId) && !(key in berkasAdmin());
    }
  }
}
