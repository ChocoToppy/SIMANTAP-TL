rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catatan penting: untuk operasi "list" (query/onSnapshot atas satu
    // koleksi, bukan satu dokumen tunggal), Firestore harus bisa membuktikan
    // aturan berlaku untuk SEMUA kemungkinan dokumen yang bisa dikembalikan
    // query itu — bukan memfilter dokumen satu per satu. Karena itu, semua
    // fungsi di bawah ini SENGAJA hanya mengandalkan request.auth (token
    // custom claim: role/kode/nim) yang nilainya tetap sepanjang satu
    // request, bukan get() ke dokumen lain yang isinya berbeda per dokumen
    // yang dibaca (mis. get(akun/$(resource.data.owner)) DILARANG di sini).
    // Query dari klien WAJIB disertai where() yang cocok (lihat App.jsx).

    function isSignedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function lecturerKode() { return request.auth.token.kode; }
    function studentNim() { return request.auth.token.nim; }

    function isAdmin() {
      return isSignedIn() && role() == 'admin'
        && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.isActive == true;
    }
    function isLecturer() {
      return isSignedIn() && role() == 'lecturer'
        && get(/databases/$(database)/documents/dosen/$(lecturerKode())).data.isActive == true;
    }
    function isStudent() {
      return isSignedIn() && role() == 'student'
        && get(/databases/$(database)/documents/akun/$(studentNim())).data.isActive == true;
    }
    function assignedTo(m) {
      return m.pembimbing1 == lecturerKode() || m.pembimbing2 == lecturerKode()
        || m.penguji1 == lecturerKode() || m.penguji2 == lecturerKode();
    }
    function ownedByMe(m) { return m.owner == studentNim(); }

    // ----- Data akademik mahasiswa (satu dokumen per program yang diikuti) -----
    // Siapa pun yang punya token login bisa memanggil Firestore langsung (tanpa
    // aplikasi), jadi aturan di bawah memeriksa ISI perubahan: mahasiswa & dosen
    // hanya bisa membuat perubahan yang memang bisa dibuat lewat portal mereka.
    // Field yang tidak tercantum di daftar mana pun (verifikasi → terverifikasi,
    // pembimbing/penguji, tanggalLulus, nomorSurat, catatan admin, dst.) hanya
    // bisa diubah admin. Menambah field yang ditulis portal mahasiswa = tambahkan
    // juga di sini.
    //
    // Satu pengajuan per program per mahasiswa: ID dokumen buatan mahasiswa
    // WAJIB "{nim}_{program}" (idPengajuan di helpers.js), dan dokumen lain yang
    // memegang pasangan (nim, program) itu dengan ID berbeda (data lama, buatan
    // admin, atau setelah ganti NIM) ditandai di slotPengajuan/{nim}_{program}.

    // Field form pendaftaran; mengubahnya mengembalikan pengajuan ke antrean verifikasi.
    function fieldForm() {
      return ['nama', 'jenisMagang', 'periode', 'angkatan', 'judul', 'dosenWali',
              'klasifikasi', 'bidang', 'tanggalMulai', 'batasAkhir', 'pendaftaran'];
    }
    // Isi m.pendaftaran yang ada di form (lihat META di utils/formPendaftaran.js).
    function fieldPendaftaran() {
      return ['syaratSKS', 'ipk', 'statusKP', 'terdaftarKRS', 'sudahUGB', 'namaPersetujuanDosen',
              'berkasLink', 'nomorWA', 'semester', 'sksIpk', 'tempatKP', 'instansi', 'alamatWA'];
    }
    // Semua field yang boleh disentuh mahasiswa pada dokumen yang sudah ada.
    // owner/nim/program sengaja tidak ada (tidak boleh berubah).
    function fieldMahasiswa() {
      return ['nama', 'jenisMagang', 'periode', 'angkatan', 'judul', 'dosenWali',
              'klasifikasi', 'bidang', 'tanggalMulai', 'batasAkhir', 'pendaftaran',
              'id', 'verifikasi', 'pernahTerverifikasi', 'aktivitas', 'tahap',
              'jadwal', 'riwayatJadwal', 'perpanjangan', 'dokumenKP', 'dokumenMagang', 'dokumenTA',
              'pembukuan'];
    }
    function semuaEvent() {
      return ['Seminar Proposal', 'Seminar Hasil', 'Sidang', 'Expo'];
    }
    // Berkas yang hanya diunggah/dibuat admin (studentUpload: false di helpers.js).
    // Daftar yang sama ada di storage.rules. baSeminar = BA Seminar KP lama (tahap
    // sudah dihapus); tetap di sini supaya berkas lama tidak bisa ditimpa mahasiswa.
    function dokumenAdmin() {
      return ['stPembimbing', 'baSeminar', 'penilaianKP', 'stPembimbingMagang', 'monevMagang', 'baExpo',
              'stPembimbingMkt', 'monevMkt', 'baExpoMkt', 'baSemproTA', 'baSemhasTA', 'baSidangTA'];
    }
    function pernahVerif(m) {
      return m.get('verifikasi', 'baru') == 'terverifikasi' || m.get('pernahTerverifikasi', false) == true;
    }

    // Pilihan di form hanya dari daftar yang dibuka admin: periode (config/global),
    // angkatan aktif, dosen aktif. '' = tidak diisi.
    function periodeBuka(p) {
      return p in get(/databases/$(database)/documents/config/global).data.get('periodeBuka', []);
    }
    function angkatanAktif(x) {
      return x == '' || get(/databases/$(database)/documents/angkatan/$(string(x))).data.get('isActive', true) != false;
    }
    function dosenAktif(kode) {
      return kode == '' || get(/databases/$(database)/documents/dosen/$(kode)).data.get('isActive', true) != false;
    }
    // 'YYYY-MM-DD' → timestamp tengah malam UTC.
    function tgl(s) {
      let p = s.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // Selain KP/Magang, form tidak punya isian tanggal: mulai = hari ini, batas = +180 hari.
    function tanggalOtomatis(d) {
      return tgl(d.batasAkhir) == tgl(d.tanggalMulai) + duration.value(180, 'd')
        && tgl(d.tanggalMulai) > request.time - duration.value(2, 'd')
        && tgl(d.tanggalMulai) < request.time + duration.value(1, 'd');
    }
    // Log (aktivitas, riwayatJadwal) hanya bisa ditambah, tidak diubah/dihapus.
    function hanyaTambah(a, b, field) {
      let la = a.get(field, []);
      let lb = b.get(field, []);
      return !a.diff(b).affectedKeys().hasAny([field])
        || (la.size() > lb.size() && la[0:lb.size()] == lb);
    }

    // Edit form pendaftaran: wajib kembali ke 'baru', tanggal hanya untuk KP/Magang.
    function formMhsAman(a, b) {
      let k = a.diff(b).affectedKeys();
      let kp = a.get('pendaftaran', {}).diff(b.get('pendaftaran', {})).affectedKeys();
      return (!k.hasAny(fieldForm()) || a.get('verifikasi', 'baru') == 'baru')
        && (!k.hasAny(['tanggalMulai', 'batasAkhir']) || b.program in ['KP', 'MG'])
        && (!k.hasAny(['jenisMagang']) || a.jenisMagang in ['Magang', 'MKT'])
        && (!k.hasAny(['periode']) || periodeBuka(a.periode))
        && (!k.hasAny(['angkatan']) || angkatanAktif(a.angkatan))
        && (!k.hasAny(['dosenWali']) || dosenAktif(a.dosenWali))
        && kp.hasOnly(fieldPendaftaran())
        && (!kp.hasAny(['namaPersetujuanDosen']) || dosenAktif(a.pendaftaran.namaPersetujuanDosen));
    }
    // Verifikasi: mahasiswa hanya bisa mengembalikan ke 'baru' (edit pendaftaran),
    // tidak bisa memverifikasi sendiri. pernahTerverifikasi (pengajuan tidak bisa
    // dihapus mahasiswa lagi) hanya bisa dipasang, tidak dicabut, dan wajib
    // dipasang saat pengajuan terverifikasi dikembalikan ke 'baru'.
    function verifikasiMhsAman(a, b) {
      let k = a.diff(b).affectedKeys();
      return (!k.hasAny(['verifikasi']) || a.verifikasi == 'baru')
        && (!k.hasAny(['pernahTerverifikasi'])
            || (a.pernahTerverifikasi == true && b.get('verifikasi', 'baru') == 'terverifikasi'))
        && (b.get('verifikasi', 'baru') != 'terverifikasi' || a.get('verifikasi', 'baru') == 'terverifikasi'
            || a.get('pernahTerverifikasi', false) == true);
    }
    // Tahap hanya bisa digeser mahasiswa lewat unggahan (uploadDokumenKP di
    // Portal.jsx): Pendaftaran → Bimbingan saat KP/Magang mengunggah surat
    // balasan, dan KP Bimbingan → Pembukuan saat mengunggah lembar pengesahan.
    function tahapMhsAman(a, b) {
      let kKP = a.get('dokumenKP', {}).diff(b.get('dokumenKP', {})).affectedKeys();
      let kMG = a.get('dokumenMagang', {}).diff(b.get('dokumenMagang', {})).affectedKeys();
      return a.get('tahap', '') == b.get('tahap', '')
        || (b.get('tahap', '') == 'Pendaftaran' && a.get('tahap', '') == 'Bimbingan'
            && ((b.program == 'KP' && kKP.hasAny(['suratBalasan']))
              || (b.program == 'MG' && kMG.hasAny(['suratBalasanMagang', 'suratBalasanMkt']))))
        || (b.program == 'KP' && b.get('tahap', '') == 'Bimbingan' && a.get('tahap', '') == 'Pembukuan'
            && kKP.hasAny(['lembarPengesahanKP']) && 'lembarPengesahanKP' in a.get('dokumenKP', {}));
    }
    // Berkas: hanya ke field program ini, bukan berkas admin, dan menambah/mengganti
    // hanya setelah pengajuan diverifikasi (syarat eligible di helpers.js).
    // Menghapus berkas sendiri selalu boleh (tombol Hapus di panel dokumen).
    function dokumenMhsAman(a, b, field, program) {
      let d = a.get(field, {}).diff(b.get(field, {}));
      return d.affectedKeys().size() == 0 || (
        b.program == program
        && !d.affectedKeys().hasAny(dokumenAdmin())
        && (d.addedKeys().size() + d.changedKeys().size() == 0 || pernahVerif(b)));
    }
    // Kegiatan yang boleh diusulkan = tombol "Ajukan jadwal" di KartuPengajuan:
    // pernah terverifikasi, punya pembimbing, dan kegiatan itu tahap saat ini
    // (atau Magang yang sudah mengunggah dokumen Persetujuan — eventAktifAwal).
    function bolehUsulJadwal(b, e) {
      return pernahVerif(b)
        && (b.get('pembimbing1', '') != '' || b.get('pembimbing2', '') != '')
        && (b.get('tahap', '') == e
          || (b.program == 'MG' && e == 'Expo'
              && ('persetujuanSmMagang' in b.get('dokumenMagang', {}) || 'persetujuanSmkpMkt' in b.get('dokumenMagang', {}))));
    }
    // Sidang: mahasiswa hanya mengisi tautan berkas (jadwal ditetapkan admin).
    // Kegiatan lain: usulan tanggal/jam/ruang/berkas; mengirim usulan selalu
    // mengosongkan konfirmasi & nilai. Jadwal yang sudah dikunci admin tidak bisa diubah.
    function evMhsAman(a, b, e) {
      let ea = a.get('jadwal', {}).get(e, {});
      let eb = b.get('jadwal', {}).get(e, {});
      let k = ea.diff(eb).affectedKeys();
      return k.size() == 0 || (bolehUsulJadwal(b, e) && (
        (e == 'Sidang' && k.hasOnly(['berkasLink', 'turnitinLink', 'folderLink']))
        || (e != 'Sidang'
            && !(eb.get('dikonfirmasi', false) == true && eb.get('tanggal', '') != '')
            && k.hasOnly(['tanggal', 'hari', 'jamMulai', 'jamSelesai', 'ruang', 'berkasLink', 'dikonfirmasi', 'hasil'])
            && ea.get('dikonfirmasi', false) == false && ea.get('hasil', '') == '')));
    }
    function jadwalMhsAman(a, b) {
      return a.get('jadwal', {}).diff(b.get('jadwal', {})).affectedKeys().hasOnly(semuaEvent())
        && evMhsAman(a, b, 'Seminar Proposal') && evMhsAman(a, b, 'Seminar Hasil')
        && evMhsAman(a, b, 'Sidang') && evMhsAman(a, b, 'Expo');
    }
    // Pembukuan KP (kirimTautan di Portal.jsx): mahasiswa hanya mengisi tautan
    // folder saat tahapnya Pembukuan. Setiap kiriman wajib mencabut centang
    // "Sudah diperiksa" (status kembali 'baru' lewat ditandaiMenunggu) —
    // persetujuan (Terverifikasi + centang) hanya dari admin.
    function pembukuanMhsAman(a, b) {
      let k = a.get('pembukuan', {}).diff(b.get('pembukuan', {})).affectedKeys();
      return k.size() == 0 || (
        b.program == 'KP' && pernahVerif(b)
        && b.get('tahap', '') == 'Pembukuan'
        && k.hasOnly(['berkasLink', 'berkasDiperiksa']) && a.pembukuan.berkasLink is string
        && a.pembukuan.get('berkasDiperiksa', false) == false);
    }
    // Perpanjangan (tombol di KartuPengajuan): minta sekali sebelum surat admin
    // tersedia; unggah/ganti surat final kapan saja setelah surat admin tersedia
    // (admin memakai versi terbaru).
    function perpanjanganMhsAman(a, b) {
      let pa = a.get('perpanjangan', {});
      let pb = b.get('perpanjangan', {});
      let k = pa.diff(pb).affectedKeys();
      let suratSiap = pb.get('suratAdminTersedia', false) == true;
      return k.size() == 0 || (
        pernahVerif(b) && b.get('tahap', '') != 'Lulus'
        && b.program in ['TA', 'KP', 'MG']
        && ((k.hasOnly(['diminta', 'alasan', 'tanggalDiminta']) && pa.diminta == true
              && pb.get('diminta', false) != true && !suratSiap)
          || (k.hasOnly(['suratFinal', 'suratFinalLink']) && suratSiap && 'suratFinal' in pa)));
    }
    // Kiriman yang menuntut tindakan admin wajib mengembalikan status ke 'baru'
    // (tandaiMenungguVerifikasi di helpers.js): usulan jadwal/berkas sidang,
    // perpanjangan, tautan Pembukuan, dan surat balasan (Pendaftaran → Bimbingan,
    // admin menetapkan pembimbing). Unggahan lain, termasuk lembar pengesahan
    // (Bimbingan → Pembukuan), tidak.
    function ditandaiMenunggu(a, b) {
      let ada = a.diff(b).affectedKeys().hasAny(['jadwal', 'perpanjangan', 'pembukuan'])
        || (b.get('tahap', '') == 'Pendaftaran' && a.get('tahap', '') == 'Bimbingan');
      return !ada || a.get('verifikasi', 'baru') == 'baru';
    }
    // Status "Perlu perbaikan": mahasiswa tidak bisa mengirim berkas/tautan,
    // usulan jadwal, maupun surat perpanjangan final sampai pendaftarannya
    // dibetulkan (bolehAksesBerkas di helpers.js). Menghapus berkas tetap boleh.
    function unggahBaru(a, b, field) {
      let d = a.get(field, {}).diff(b.get(field, {}));
      return d.addedKeys().size() + d.changedKeys().size() > 0;
    }
    function perbaikanTerkunci(a, b) {
      return b.get('verifikasi', 'baru') != 'perbaikan' || !(
        a.diff(b).affectedKeys().hasAny(['jadwal', 'pembukuan'])
        || unggahBaru(a, b, 'dokumenKP') || unggahBaru(a, b, 'dokumenMagang') || unggahBaru(a, b, 'dokumenTA')
        || a.get('perpanjangan', {}).diff(b.get('perpanjangan', {})).affectedKeys().hasAny(['suratFinal', 'suratFinalLink']));
    }
    function perubahanMhsAman(a, b, id) {
      let k = a.diff(b).affectedKeys();
      return k.hasOnly(fieldMahasiswa())
        && ditandaiMenunggu(a, b)
        && perbaikanTerkunci(a, b)
        && (!k.hasAny(['id']) || a.id == id)
        && formMhsAman(a, b)
        && verifikasiMhsAman(a, b)
        && tahapMhsAman(a, b)
        && jadwalMhsAman(a, b)
        && perpanjanganMhsAman(a, b)
        && pembukuanMhsAman(a, b)
        && dokumenMhsAman(a, b, 'dokumenKP', 'KP')
        && dokumenMhsAman(a, b, 'dokumenMagang', 'MG')
        && dokumenMhsAman(a, b, 'dokumenTA', 'TA')
        && hanyaTambah(a, b, 'aktivitas')
        && hanyaTambah(a, b, 'riwayatJadwal');
    }

    // Pengajuan baru dari mahasiswa: hanya isi form pendaftaran dengan pilihan
    // yang dibuka admin, status awal, tanpa dosen/jadwal/berkas, dan belum ada
    // pengajuan lain untuk program itu.
    function pengajuanBaruAman(d, id) {
      return d.owner == studentNim() && d.nim == studentNim()
        && d.program in ['TA', 'KP', 'CAP', 'MG', 'S2']
        && id == studentNim() + '_' + d.program
        && d.get('id', id) == id
        && !exists(/databases/$(database)/documents/slotPengajuan/$(id))
        && d.keys().hasOnly(['id', 'program', 'nama', 'nim', 'owner', 'jenisMagang', 'judul', 'periode',
              'angkatan', 'klasifikasi', 'bidang', 'dosenWali', 'pembimbing1', 'pembimbing2', 'penguji1',
              'penguji2', 'tahap', 'tanggalMulai', 'batasAkhir', 'dibatalkan', 'catatan', 'jadwal',
              'verifikasi', 'pendaftaran', 'aktivitas'])
        && d.verifikasi == 'baru' && d.tahap == 'Pendaftaran'
        && d.get('pembimbing1', '') == '' && d.get('pembimbing2', '') == ''
        && d.get('penguji1', '') == '' && d.get('penguji2', '') == ''
        && d.get('catatan', '') == '' && d.get('dibatalkan', false) == false
        && d.get('jadwal', {}).size() == 0
        && d.get('aktivitas', []).size() == 1
        && d.get('pendaftaran', {}).keys().hasOnly(fieldPendaftaran())
        && d.get('jenisMagang', 'Magang') in ['Magang', 'MKT']
        && periodeBuka(d.periode)
        && angkatanAktif(d.get('angkatan', ''))
        && dosenAktif(d.get('dosenWali', ''))
        && dosenAktif(d.get('pendaftaran', {}).get('namaPersetujuanDosen', ''))
        && (d.program in ['KP', 'MG'] || tanggalOtomatis(d));
    }

    // Dosen hanya membaca (DosenPortal.jsx tidak menulis apa pun).
    match /mahasiswa/{id} {
      allow read: if isAdmin()
        || (isLecturer() && assignedTo(resource.data))
        || (isStudent() && ownedByMe(resource.data));
      allow update: if isAdmin()
        || (isStudent() && ownedByMe(resource.data) && perubahanMhsAman(request.resource.data, resource.data, id));
      allow delete: if isAdmin()
        || (isStudent() && ownedByMe(resource.data)
            && resource.data.get('verifikasi', 'baru') != 'terverifikasi'
            && resource.data.get('pernahTerverifikasi', false) != true);
      allow create: if isAdmin()
        || (isStudent() && pengajuanBaruAman(request.resource.data, id));
    }

    // ----- Penanda pengajuan per (nim, program) yang ID dokumennya bukan "{nim}_{program}" -----
    // { mahasiswaId, owner, program }. Ditulis admin (simpanMahasiswa), Cloud
    // Functions (ganti NIM) dan skrip functions/migrate-slot-pengajuan.js.
    // Mahasiswa boleh menghapus penanda miliknya hanya bila dokumen yang
    // ditandainya sudah tidak ada (dihapus lebih dulu, lihat hapusMahasiswa di App.jsx).
    match /slotPengajuan/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin() || (isStudent() && (
        (resource == null && id.matches(studentNim() + '_[A-Za-z0-9]+'))
        || (resource != null && resource.data.owner == studentNim()
            && !existsAfter(/databases/$(database)/documents/mahasiswa/$(resource.data.mahasiswaId)))
      ));
    }

    // ----- Akun login mahasiswa -----
    match /akun/{nim} {
      allow read: if isAdmin() || (isStudent() && studentNim() == nim);
      // Mahasiswa hanya boleh membersihkan sendiri flag mustChangePassword
      // miliknya sendiri setelah ganti password — selain itu (isActive, dst.)
      // hanya admin/Cloud Functions yang boleh menulis.
      allow update: if isAdmin() || (
        isStudent() && studentNim() == nim &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']) &&
        request.resource.data.mustChangePassword == false
      );
      allow create, delete: if isAdmin();
    }

    // ----- Data dosen (profil + akun login) -----
    match /dosen/{kode} {
      allow read: if isSignedIn(); // nama dosen perlu tampil luas (pembimbing/penguji)
      allow update: if isAdmin() || (
        isLecturer() && lecturerKode() == kode &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']) &&
        request.resource.data.mustChangePassword == false
      );
      allow create, delete: if isAdmin();
    }

    // ----- Akun admin -----
    match /admin/{uid} {
      allow read: if isAdmin();
      // Admin hanya boleh membersihkan sendiri flag mustChangePassword miliknya
      // sendiri setelah ganti password — sama seperti akun/dosen di atas.
      allow update: if isAdmin() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']) &&
        request.resource.data.mustChangePassword == false;
      allow create, delete: if false; // hanya lewat Cloud Functions / skrip migrasi (Admin SDK)
    }

    // ----- Peta login (NIM/NIP -> email) untuk lookup sebelum login -----
    match /loginIndex/{id} {
      allow get: if true;
      allow list, write: if false; // hanya Cloud Functions (Admin SDK) yang menulis
    }

    // ----- Log audit reset password oleh admin -----
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false; // hanya Cloud Functions (Admin SDK)
    }

    // ----- Konfigurasi umum (periode, pengumuman, panduan) -----
    match /config/{document} {
      allow read: if true; // ditampilkan di halaman login publik
      allow write: if isAdmin();
    }

    // ----- Jadwal ruang (fitur eksperimental): ruang master, semester, booking -----
    // Non-admin hanya boleh membaca yang sudah terbit; query klien WAJIB disertai
    // where('status'|'terbit','==', ...) yang cocok (lihat useJadwalRuang.js).
    match /ruang/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /semesterRuang/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.status == 'terbit');
      allow write: if isAdmin();
    }
    match /booking/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.terbit == true);
      allow write: if isAdmin();
    }

    // ----- Registri nomor surat: satu dokumen per nomor yang pernah dipakai (diketik
    // admin atau diisi lewat "Isi nomor berikutnya"), tidak pernah dihapus (nomor
    // kedaluwarsa tidak boleh dipakai ulang). Hanya admin (lewat nomorSuratDb.js).
    // Koleksi nomorSuratCounter/ tidak dipakai lagi: nomor berikutnya dicari langsung
    // dari registri, jadi tidak ada aturan untuknya (tertolak). -----
    match /nomorSurat/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // ----- Daftar angkatan yang bisa dipilih saat pendaftaran (arsip, bukan
    // hapus, spy data mahasiswa lama tetap konsisten — lihat SeksiAngkatan.jsx) -----
    match /angkatan/{id} {
      allow read: if isSignedIn(); // mahasiswa perlu lihat pilihan saat mendaftar
      allow write: if isAdmin();
    }
  }
}
