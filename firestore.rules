rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /mahasiswa/{document} {
      allow read, write: if true;
    }
    match /dosen/{document} {
      allow read, write: if true;
    }
    match /akun/{document} {
      allow read, write: if true;
    }
    match /config/{document} {
      allow read, write: if true;
    }
  }
}
